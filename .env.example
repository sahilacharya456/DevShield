# ============================================================
#  DevShield AI X — Environment Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# --- App Configuration ---
APP_OWNER=Sahil
APP_NAME="DevShield AI X"
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Security ---
SECRET_KEY=generate_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Database ---
# For SQLite, use: sqlite+aiosqlite:///devshield_v2.db
# For PostgreSQL, use the variables below
DATABASE_URL=sqlite+aiosqlite:///devshield_v2.db
POSTGRES_USER=devshield_user
POSTGRES_PASSWORD=devshield_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devshield_db
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider Configuration ---
# LLM_PROVIDER can be 'gemini' or 'groq'
LLM_PROVIDER=gemini

# --- Gemini API Key (REQUIRED) ---
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Groq API Key (REQUIRED if using Groq) ---
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# --- Threat Intelligence API Keys (OPTIONAL) ---
# Set these keys to activate advanced programmatic feeds
NEXT_PUBLIC_ABUSEIPDB_API_KEY=
NEXT_PUBLIC_VIRUSTOTAL_API_KEY=
NEXT_PUBLIC_OTX_API_KEY=
NEXT_PUBLIC_GREYNOISE_API_KEY=

SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=
ALLOWED_SCAN_TARGETS=
ALLOW_PRIVATE_SCAN_TARGETS=true
